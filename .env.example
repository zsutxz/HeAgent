# HeAgent 配置示例
#
# 复制为 .env 后填写真实值：
#   cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# 读取优先级：系统环境变量 > 项目 .env > 用户全局 ~/.heagent/.env > 字段默认值
# 字段与 src/heagent/config.py 的 Settings 一一对应；本文件未列出的字段一律用默认值。
#
# 写法约定：
#   未注释的行       = 需要填写（凭据留空）或值得显式写出的默认值；
#   `# KEY=value`    = 可选开关，取消注释即生效（示例值多为代码默认值，按需修改）；
#   可选**数值**项（如 MAX_OUTPUT_TOKENS）留空会解析失败，不设时请整行注释掉或删除；
#   空值行（`KEY=`）不要带行尾 `# 注释`——python-dotenv 只在「有值」时才剥离行尾注释。

# 目录：1 凭据与端点 · 2 默认模型 · 3 本地 Ollama · 4 智能路由 · 5 运行参数 ·
#       6 Token 计量 · 7 重试 · 8 技能/记忆/上下文 · 9 事件传输 · 10 Cron 与 Dreaming ·
#       11 状态清理 · 12 MCP 与工具黑名单 · 13 沙箱 · 14 审批/Plan Mode ·
#       15 用户事件钩子 · 16 成本估算 · 17 日志

# ---------- 1 Provider 凭据与端点 ----------
# 至少配置一个凭据。条目名（/model 与 ROUTING_POOLS 使用的名字）：
#   deepseek / kimi / glm / ollama / openai / gpt / anthropic
# 构建顺序（= 多 provider 自动回退顺序、交互式启动选择的默认项）：
#   deepseek -> kimi -> glm -> ollama -> openai -> gpt -> anthropic
# 提示：密钥只写在本文件生成出的 .env / 系统环境变量里，切勿提交进版本库。

# 交互模式启动时的默认条目；须是已成功构建的条目名（如 deepseek）。
# 未设置或该条目不可用时，回退到第一个可用条目。
# ACTIVE_PROVIDER=deepseek

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Kimi (Moonshot) ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---- GLM (智谱) ----
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- OpenAI（Chat Completions 兼容；亦可用于 vLLM / 自营代理）----
OPENAI_API_KEY=
# 留空 = 用 SDK 默认端点；接第三方兼容服务时须显式填写。
OPENAI_BASE_URL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# 提示词缓存：对不支持 cache_control 的代理请显式关闭。
ANTHROPIC_PROMPT_CACHING=true

# ---- OpenAI Responses API（gpt 条目；wire_api="responses" 的中转站）----
# 区别于上方 OPENAI_API_KEY（Chat Completions API）；本项走 /v1/responses，/model gpt 切换。
# OPENAI_RESPONSES_API_KEY=
# OPENAI_RESPONSES_BASE_URL=https://www.komapi.top/v1

# ---- 多 key 池 ----
# 同一 Provider 可配置多个 key（逗号分隔），运行时会去重并组装为 KeyRotatingProvider。
# OPENAI_API_KEYS=sk-key1,sk-key2
# ANTHROPIC_API_KEYS=key1,key2

# ---------- 2 各条目默认模型 ----------
# 仅在该条目**未**出现在 ROUTING_POOLS（第 4 节）时生效；有池时模型由池的 tiers 决定，
# 此处与 --model 都会被忽略（--model 另会打一条 warning）。示例值 = 代码默认值。

# DEFAULT_MODEL=gpt-4o            # openai（Chat Completions）与 anthropic 条目的兜底模型
# DEEPSEEK_MODEL=deepseek-v4-pro
# KIMI_MODEL=kimi-k3
# GLM_MODEL=glm-5.3
# OPENAI_MODEL=gpt-5.6-terra      # gpt（Responses API）条目

# ---------- 3 本地 Ollama（OpenAI 兼容 /v1，显式 opt-in） ----------
# 启用后 CLI 把 ollama 条目构建为 OpenAIProvider（Ollama 不校验 API Key，无需配 key），
# 与云端 provider 并列入池，可经 /model 切换、--model 覆盖模型名。
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b          # 启用时必填，缺失则启动即报错退出
# 未填 API Key 时用占位符 "ollama"（Ollama 不校验 key）：
# OLLAMA_API_KEY=
# 查看本机模型名与窗口：curl http://127.0.0.1:11434/api/tags
# 注意：本地窗口常远小于 MAX_CONTEXT_TOKENS 默认 512000（Ollama 实际取 Modelfile 的 num_ctx），
#       须按实际值下调，否则压缩/窗口重置阈值永不触发、先撞 API 400。

# ---------- 4 智能路由（唯一入口：ROUTING_POOLS 声明式路由池） ----------
# 单个 JSON 对象，键 = provider 条目名（deepseek / kimi / glm / ollama / openai / gpt /
# anthropic；该条目须已配好凭据；**条目一旦出现在这里即为启用该池**），值 = 池规格：
#   {"tiers": {"<池内名>": "<模型名>", ...},   # 必填、有序；池内名即 /route 接受的名字
#    "roles": {"fast": "<池内名>", "mid": "<池内名>", "pro": "<池内名>"},   # 可选角色映射
#    "default": "<池内名>",                   # 可选，默认档（缺省 = fast 档）
#    "keywords": {"mid": "词1,词2", "pro": "词1,词2"},   # 可选，命中即路由到该档
#    "base_url": "https://...",               # 可选，覆盖该池的 base_url
#    "reasoning_continuity": false}           # 可选，覆盖该池的推理链续接
# 缺 roles 时按名字推断：池内名恰为 fast/mid/pro 者优先，否则首档 = fast、末档 = pro；
# 三档同义名（如 terra/luna/sol）的中档须显式写 roles。
# 池声明了但该条目无凭据 -> 告警并跳过该池（其他 provider 不受影响）。
# 调整档位模型 / 新增档位 / 改角色与关键词只改这一行，**无需改代码**。
# 例：
# ROUTING_POOLS={"glm":{"tiers":{"fast":"glm-5.3-flash","pro":"glm-5.3"},"keywords":{"pro":"分析,证明"}}}
# ROUTING_POOLS={"gpt":{"tiers":{"terra":"gpt-5.6-terra","luna":"gpt-5.6-luna","sol":"gpt-5.6-sol"},"roles":{"fast":"terra","mid":"luna","pro":"sol"},"default":"terra"}}
# ROUTING_POOLS={"deepseek":{"tiers":{"fast":"deepseek-flash","pro":"deepseek-v4-pro"}}}

# 推理链续接（判据 1，**所有池的默认值**；单池可在上面用 "reasoning_continuity" 覆盖）：
# true 时「上一轮走了 pro 且思考痕迹仍在历史中」会让后续轮次即使没命中关键词也继续走 pro；
# 默认 false = 尽量用 fast（只按当前请求判定，历史命中不锁定）。
# ROUTING_REASONING_CONTINUITY=false
# 注：旧版按 provider 的开关（ROUTING_ENABLED / ROUTING_FAST_MODEL / ROUTING_PRO_MODEL /
#     ROUTING_REASONING_KEYWORDS / GPT_ROUTING_*）已移除，请在 ROUTING_POOLS 里声明对应池。

# ---------- 5 Agent 运行参数 ----------

# MAX_ITERATIONS=50              # 单次 run 的主循环迭代上限
# GOAL_MAX_ITERATIONS=20         # /goal 声明式工作流每个步骤子代理的迭代预算（步骤可用 max_iterations 覆盖）
# SUBAGENT_MAX_DEPTH=3           # 子 Agent 委派嵌套深度上限（0=禁止委派；超限工具返回 status=error）
# SUBAGENT_MAX_ITERATIONS=20     # 嵌套子代理兜底迭代预算（角色未声明 max_iterations 时生效）
# GOAL_CHECKPOINT_MODE=prompt    # prompt=终端确认；auto=checkpoint 后自动继续
# GOAL_OPEN_QUESTION_MODE=block  # block=开放问题停 waiting_user；default=按推荐默认推进并记录假设
# GOAL_WORKFLOW_SKILL=he-goal # /goal 工作流包 id（在 .heagent/skills/he-goal/SKILL.md 里声明 canonical_id）
# ANNOUNCE_PROGRESS=true         # ▶启动/✔完成 公告与状态行是否写 stderr；false=静音（公告会挤进交互输入行时用）
# COMPRESSION_THRESHOLD=0.8      # 上下文压缩触发阈值（窗口占比）
# CONTEXT_STRATEGY=compressor    # compressor=原地摘要压缩；reset=窗口重置(清窗后 resume 续跑)
# WINDOW_RESET_THRESHOLD=0.6     # context_strategy=reset 时生效
# MAX_CONTEXT_TOKENS=512000      # 须 ≤ 所用模型的实际窗口，否则阈值永不触发、先撞 API 400
# MAX_OUTPUT_TOKENS=4096         # 单次输出 token 上限（不设则整行注释掉，留空会解析失败；本地思考模型建议设）
# SHELL_TIMEOUT=120              # shell 工具超时（秒）

# ---------- 6 Token 计量 ----------
# auto（默认）= 装了 tiktoken 用真实 tokenizer，否则 CJK 感知启发式并按 provider 返回的真实
# usage 在线校准系数；estimate = 强制启发式（对齐旧行为 / 离线复现）；tiktoken = 强制真实
# （依赖缺失时告警一次后回退）。计量结果决定压缩阈值与窗口重置判定。
# TOKENIZER=auto

# ---------- 7 重试参数 ----------

# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=1.0
# RETRY_MAX_DELAY=30.0

# ---------- 8 技能 / 记忆 / 上下文 ----------

# SKILL_MATCH_THRESHOLD=0.3
# SKILL_MAX_AUTO_INVOKE=3
# SKILL_MAX_AUTO_INVOKE_TOKENS=8192  # 自动注入技能正文的总估算 token 预算；不设则整行注释掉（留空会解析失败）
# SKILL_MAX_MANUAL_LOAD_TOKENS=8192  # skill_load 的完整技能读取上限；超出时拒绝，不截断正文
# SKILL_CURATOR_STALE_DAYS=30        # 技能策展：多久未使用视为过期
# MEMORY_NUDGE_ENABLED=true          # 是否注入「记得保存记忆」提醒
# MEMORY_INJECT_MAX_BYTES=49152      # <memory> 注入字节预算（0=不限制）；超预算按文件顺序保留前部条目
#                                    # 并在块尾标注省略条数，文件本体不改动（整理 MEMORY.md 释放预算）
# CONTEXT_FILES_ENABLED=true
# CONTEXT_FILES_MAX_BYTES=32768      # 上下文文件字节预算；超预算时近端（更靠近 cwd）优先，被丢弃者显式标注
# CONTEXT_FILES_USER_LEVEL=false     # 是否纳入用户级 ~/.heagent/AGENTS.md（全局文件，默认关闭）

# ---------- 9 事件传输与回放 ----------
# 落盘 .heagent/runs/<run_id>/rollout.jsonl（`heagent replay <file>` 可回放）；含工具原始输出。
# 单次模式加 --json 可把同一事件流写到 stdout（与 rollout 开关互不影响）。
# EVENTS_ROLLOUT_ENABLED=false

# ---------- 10 Cron 与 Dreaming ----------

# CRON_ENABLED=true
# CRON_TICK_SECONDS=60

# Dreaming（离线记忆巩固，opt-in）：无人监督后台跑 + 联网 + 改持久记忆，
# 非安全边界（PolicyEngine / role / web 围栏均非真边界，须 OS 级沙箱兜底），默认关闭。
# 触发方式二者共用同一 tick：cron 时刻命中，或距上次 run 结束已空闲 DREAM_IDLE_MINUTES。
# DREAM_ENABLED=false
# DREAM_CRON=0 3 * * *           # 5 字段 cron 表达式，构造期校验（默认凌晨 3 点低峰）
# DREAM_IDLE_MINUTES=30          # 0 = 禁用 idle 触发
# DREAM_MAX_ITERATIONS=20        # dreamer 子代理独立预算（不复用 MAX_ITERATIONS）
# DREAM_SESSION_LOOKBACK=5       # 预加载近期 session 个数

# ---------- 11 状态清理 ----------
# 两项都在「全新 run 启动时」各清理一次；0 = 禁用清理。

# .heagent/ledger/ 幂等记录超过此天数即删除（默认 7）。
# LEDGER_RETENTION_DAYS=7

# .heagent/runs/ 的 run 快照（<run_id>.json + 配套 .lock + <run_id>/ 产物目录）超过此天数即删除。
# 注意：persist.py 刻意保留 .lock 文件（规避 unlink 竞态），本项是 runs 侧唯一的回收时机。
# RUN_RETENTION_DAYS=7

# 过期清理的跨进程节流（秒）：距上次清理不足此间隔就跳过扫描（0 = 每次都扫）。
# 每次全新 run 启动都要扫 .heagent/runs + .heagent/ledger，短命 CLI 进程靠这层省掉重复扫描。
# PRUNE_MIN_INTERVAL_SECONDS=900

# 以下三项由 CLI/GUI 启动时的 housekeeping 回收（此前无回收方，会随使用单调增长）；
# 0 = 禁用该类清理。
# logs/ 日志文件（每次启动新建，含完整 prompt / 工具输出）：
# LOG_RETENTION_DAYS=14
# .heagent/sessions/ 会话文件（老会话基本不再被 --continue 使用）：
# SESSION_RETENTION_DAYS=30
# .heagent/tmp/edit-snapshots/ 编辑快照（「误改后悔药」，每次编辑都可能新增）：
# EDIT_SNAPSHOT_RETENTION_DAYS=7

# ---------- 12 MCP 与工具黑名单 ----------

# MCP_ENABLED=true
# MCP_CONFIG_PATH=.mcp.json

# 工具名黑名单：命中即由 SafetyGuard 在执行前拦截，对**所有**工具生效（内置 / shell / MCP）。
# 值是 **JSON 数组**（不是逗号分隔），元素为正则片段、大小写不敏感；默认空 = 不拦。
# SAFETY_BLOCKED_TOOLS=["shell","delete_repository"]

# ---------- 13 沙箱（后端 / 权限档位 / 网络） ----------
# 后端：auto（默认）= 探测 firejail，可用则用（Linux/macOS），否则 passthrough；
#       passthrough = 零隔离；firejail = FirejailBackend；winjob = Windows Job Objects。
#       auto **不**自动选 winjob——Job 无文件系统隔离，自动启用会改掉所有 shell 命令的
#       进程语义而隔离收益有限；需要时显式写 winjob。CLI --sandbox 可覆盖。
# SANDBOX_BACKEND=auto
# SANDBOX_FIREJAIL_PATH=firejail

# 权限档位：
#   read-only          = 只放行只读工具（file_read / git_* / web_fetch 等）；写操作与 shell
#                        一律 BLOCKED，未知工具同样拒绝（fail-closed）；
#   workspace-write    = 默认：写操作受工作区围栏 + 凭证 deny + 审批管辖；
#   danger-full-access = 跳过围栏与凭证 deny 预检（显式危险模式，仅限受控环境）。
# 非法值回退 workspace-write 并告警（不阻断启动）。
# SANDBOX_MODE=workspace-write

# 网络开关：false（默认）= 禁止子进程出站。**仅 firejail 能强制**（映射为 --net=none）；
# passthrough / winjob 无网络隔离能力，此时日志会明确说明「隔离未生效」而非假装生效。
# 注：宿主进程内的 web_fetch 不受此开关约束。
# SANDBOX_NETWORK=false

# 强制开关：true（默认）= 探测到**真实**沙箱后端时，自动把 shell 纳入沙箱工具集并授权当次
# run 走沙箱路径。无真实后端（passthrough）时不改变任何行为——不给「已在沙箱里跑」的假象。
# SANDBOX_ENFORCE=true

# 会话目录：true = 每个 run 建 <workspace>/.heagent/sandboxes/<run_id>/ 作为沙箱工作目录
# （firejail 作 --private 根 / winjob 作子进程 cwd）；SESSION_KEEP=true 时 run 结束保留。
# 两者都可用 CLI/GUI 开关双向覆盖（未传标志时跟随这里）：
#   --sandbox-session-workspace / --no-sandbox-session-workspace
#   --sandbox-session-keep / --no-sandbox-session-keep
# SANDBOX_SESSION_WORKSPACE=false
# SANDBOX_SESSION_KEEP=false

# 崩溃 run 的会话目录回收（E40-D1）：正常结束由 teardown 删除；crash / SIGKILL 留下的
# 孤儿目录由 CLI/GUI 启动时按本保留期回收（0 = 禁用）。正在写的 run 不会被删（按目录 +
# 直接子项最新 mtime 判活），符号链接与非目录条目一律不动。
# SANDBOX_DIR_RETENTION_DAYS=7

# env 豁免：逗号分隔变量名（如 GITHUB_TOKEN），命中的变量不参与子进程 env 敏感剥离。
# SANDBOX_ENV_ALLOWLIST=

# profile → firejail 参数映射（JSON）：高级隔离参数（--seccomp / --caps.drop 等）经此声明，
# 默认关闭。示例：SANDBOX_PROFILES={"default": ["--seccomp", "--caps.drop=all"]}
# profile 名即 PolicyEngine.sandbox_profiles 的值（缺省 "default"；MCP 工具缺省 "mcp"）。
# 均为 defense-in-depth 启发式层，**非真正安全边界**，须 OS 级沙箱兜底。
# SANDBOX_PROFILES=

# 工具 → profile 名映射（JSON，per-tool 参数粒度）：单个工具差异化选用 profile。
# 示例：SANDBOX_TOOL_PROFILES={"shell": "strict", "mcp_github__run": "network-off"}
# 空 = 现状（全部落 "default"）。
# SANDBOX_TOOL_PROFILES=

# 资源限额（0=关闭）：沙箱内 shell 子进程的内存上限（MB）、CPU 时间上限（秒）、进程数上限。
# firejail 映射 --rlimit-as / --rlimit-cpu / --rlimit-nproc；
# winjob 映射 Job Memory / Process Time / Active Process 限额。
# 限额触发 → 子进程被终止 → 非零退出码经正常结果回传（显性失败，不会静默截断输出）。
# ⚠ SANDBOX_NPROC_LIMIT 两个后端语义不对称：firejail 的 --rlimit-nproc 是
# setrlimit(RLIMIT_NPROC)，Linux 上按**真实 UID** 计数（非 per-sandbox），设小了会波及
# 同一用户的其他进程；winjob 的 Active Process 才是 job 作用域。故默认关闭。
# SANDBOX_MEMORY_LIMIT_MB=0
# SANDBOX_CPU_SECONDS=0
# SANDBOX_NPROC_LIMIT=0

# ---------- 14 审批 / Plan Mode ----------
# 逗号分隔的需要交互审批的工具名（如 "shell,file_write"）。空 = 无审批工具。
# 交互模式会在这些工具执行前询问 [y/N]；单次模式非 tty 时保持 auto-deny。
# APPROVAL_TOOLS=

# true = 只读规划模式：仅允许 readOnlyHint 工具，禁用 shell / 写文件等写操作。CLI --plan 可覆盖。
# PLAN_MODE=false

# ---------- 15 用户事件钩子（Epic 32） ----------
# true = 加载 workspace 下 .heagent/hooks.json（PreToolUse 可阻断 / PostToolUse /
#        SessionStart / SessionEnd 执行用户配置的本地命令）。
# 默认 false：hooks 以当前用户权限执行任意命令（非安全边界），不可信仓库可投放
# hooks.json 自动执行——须显式开启。hook 子进程仅继承白名单环境变量（不含 API key）。
# HOOKS_ENABLED=false

# ---------- 16 成本估算（Epic 34） ----------
# 模型价格表 JSON：{"<model>": {"input": <$/M tok>, "output": <$/M tok>}}。空 = 不显示成本。
# 例：{"deepseek-v4-pro": {"input": 0.27, "output": 1.1}}
# MODEL_PRICING=

# ---------- 17 日志 ----------
# LOG_DIR 相对当前工作目录；每次启动在下面新建 heagent-<时间戳>.log。
# LOG_LEVEL 控制 stderr 控制台级别：DEBUG / INFO / WARNING / ERROR。
# LOG_FILE_LEVEL 控制文件日志级别；不设（注释掉本行）时回退到 LOG_LEVEL。

# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_FILE_LEVEL=

# ---------- 18 TCP 网络入口（Epic 48，实验性） ----------
# 只有显式的 `heagent tcp-server` 命令会读这些值：普通 heagent / GUI / 库用法不监听任何端口，
# 也没有隐式开关（显式子命令是唯一启动方式，默认完全关闭）。
# 定位：实验性、**无认证、无 TLS**，默认只绑 localhost；公网暴露不在支持范围内。
# 收到的输入即不可信用户输入——TCP 入口不是认证/授权/安全边界（与 SafetyGuard/PolicyEngine
# 同为 defense-in-depth），对外提供服务须 OS 级沙箱兜底（见 CLAUDE.md 安全声明）。
# 协议：客户端只发 {"id": "...", "prompt": "..."}（UTF-8 JSON Lines，一行一条，单请求单响应）；
# system / provider / model / 工具策略 / 沙箱 / 迭代预算全部取自服务端配置，请求体改不了。
# CLI 同名参数可覆盖（--host / --port / --max-connections / --max-inflight / --max-request-bytes
# / --idle-timeout / --request-timeout / --shutdown-timeout），覆盖只作用于本次服务、不写回设置。
# 非法值（端口 0 / 连接数 0 / 非正超时 / 空 host）在加载时显式校验失败，不会静默变成「无限制」。

# TCP_HOST=127.0.0.1                 # 绑定地址（非回环值启动时 stderr + 日志各一条「无认证 / 无 TLS」告警）
# TCP_PORT=8765
# TCP_MAX_CONNECTIONS=32             # 同时打开的客户端连接上限（超限的新连接立即收 rate_limited）
# TCP_MAX_INFLIGHT_REQUESTS=4        # 同时在途 Agent 运行上限（超限的请求立即收 rate_limited，不排队）
# TCP_MAX_REQUEST_BYTES=1048576      # 单条请求行最大字节数（StreamReader 与协议校验共用同一上限）
# TCP_IDLE_TIMEOUT=60                # 等待完整请求行的秒数（只覆盖读取阶段，不含 Agent 预算）
# TCP_REQUEST_TIMEOUT=300            # 单次 Agent 运行的秒数（只覆盖 handler，不含写回与关连接）
# TCP_SHUTDOWN_TIMEOUT=5             # 关闭时等待在途连接收尾的秒数，超时取消残留任务

# ---------- 19 HTTP 网页入口（Epic 49，实验性） ----------
# `heagent http-server` 提供本机网页入口（内置聊天页 + /api/* 同源 JSON 接口）；
# 显式 gui / tcp-server / init / replay 不会附带启动 HTTP 服务。
# 定位与 TCP 入口一致：实验性、**无认证、无 TLS**，默认只绑 localhost；非回环绑定必须显式告警
# （判定与文案复用 network/exposure.py）。收到的请求即不可信输入——回环也不是认证边界，
# 对外提供服务须 OS 级沙箱兜底（见 CLAUDE.md 安全声明）。
# 同源与渲染：页面与 /api/* 由同一个 ASGI app 提供（不启用宽泛 CORS）；内置页面不加载任何
# 第三方脚本，响应统一带 CSP / X-Content-Type-Options: nosniff / 禁止 framing；提示词与 Agent
# 输出按纯文本渲染（不渲染不可信 HTML）。
# 依赖：HTTP 栈（starlette / uvicorn）是**可选 extra**，缺失时命令给出安装提示：
#   pip install "heagent[http]"
# 没有 HTTP_ENABLED 开关：启动语义由「调用了哪个命令」唯一决定，配置里不出现第二套状态。
# CLI 同名参数可覆盖（--host / --port / --max-connections / --max-inflight-runs / --max-request-bytes
# / --event-buffer-size / --run-history-size / --request-timeout / --shutdown-timeout），
# 覆盖只作用于本次服务实例、不写回设置单例。
# 非法值（端口 1..65535、计数为 0、非正超时、空 host）在加载时显式校验失败，不会静默变成「无限制」。

# HTTP_HOST=127.0.0.1                # 绑定地址（非回环值启动时 stderr 一行 + 日志一条明确告警）
# HTTP_PORT=8766                     # 与 TCP 默认 8765 错开，两个入口可同时开
# HTTP_MAX_CONNECTIONS=16            # 同时打开的客户端连接上限（超限连接被 Uvicorn 直接拒绝；内部另预留 1 条给就绪探测）
# HTTP_MAX_INFLIGHT_RUNS=1           # 同时在途网页 Agent 运行上限（MVP 单会话单运行，超限收 run_conflict）
# HTTP_MAX_REQUEST_BYTES=65536       # 单个 JSON 请求体字节上限（超限收 request_too_large）
# HTTP_EVENT_BUFFER_SIZE=512         # 每个 run 的 SSE 事件环形缓冲条数（越过窗口的重连收 resync_required）
# HTTP_RUN_HISTORY_SIZE=64           # 已终结 run 记录的保留条数（淘汰后按其 id 订阅收 unknown_run）
# HTTP_REQUEST_TIMEOUT=300           # 单次网页 Agent 运行的秒数（超时按 timed_out 终结并释放名额）
# HTTP_SHUTDOWN_TIMEOUT=5            # 关闭时「停止接收 → 终结在途 run → 关订阅 → 关 listener」的等待上限
