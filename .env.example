# HeAgent 配置示例
#
# 复制为 .env 后填写真实值：
#   cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# 读取优先级：系统环境变量 > 项目 .env > 用户全局 ~/.heagent/.env > 字段默认值
# 字段与 src/heagent/config/ 的 Settings 一一对应；本文件未列出的字段一律用默认值。
#
# 写法约定：
#   未注释的行       = 需要填写（凭据留空）或值得显式写出的默认值；
#   `# KEY=value`    = 可选开关，取消注释即生效（示例值多为代码默认值，按需修改）；
#   可选**数值**项（如 MAX_OUTPUT_TOKENS）留空会解析失败，不设时请整行注释掉或删除；
#   空值行（`KEY=`）不要带行尾 `# 注释`——python-dotenv 只在「有值」时才剥离行尾注释。

# 目录：1 凭据与端点 · 2 默认模型 · 3 本地 Ollama · 4 智能路由 · 5 运行参数 ·
#       6 Token 计量 · 7 重试 · 8 技能/记忆/上下文 · 9 事件传输 · 10 Cron 与 Dreaming ·
#       11 状态清理 · 12 MCP 与工具黑名单 · 13 沙箱 · 14 审批/Plan Mode ·
#       15 用户事件钩子 · 16 成本估算 · 17 日志 · 18 HTTP/WS 入口

# ---------- 1 Provider 凭据与端点 ----------
# 至少配置一个凭据。条目名（/model 与 ROUTING_POOLS 使用）：deepseek / kimi / glm / ollama / openai / gpt / anthropic
# 构建顺序（= 多 provider 自动回退顺序）：deepseek -> kimi -> glm -> ollama -> openai -> gpt -> anthropic
# 密钥只写在本文件生成出的 .env / 系统环境变量里，切勿提交进版本库。

# 交互模式启动时的默认条目；未设置或不可用时回退到第一个可用条目。
# ACTIVE_PROVIDER=deepseek

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Kimi (Moonshot) ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---- GLM (智谱) ----
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- OpenAI（Chat Completions 兼容；亦可用于 vLLM / 自营代理）----
OPENAI_API_KEY=
# 留空 = 用 SDK 默认端点；接第三方兼容服务时须显式填写。
OPENAI_BASE_URL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# 对不支持 cache_control 的代理请显式关闭。
ANTHROPIC_PROMPT_CACHING=true

# ---- OpenAI Responses API（gpt 条目；wire_api="responses" 的中转站）----
# 区别于上方 OPENAI_API_KEY（Chat Completions）；本项走 /v1/responses，/model gpt 切换。
# OPENAI_RESPONSES_API_KEY=
# OPENAI_RESPONSES_BASE_URL=https://www.komapi.top/v1

# ---- 多 key 池 ----
# 同一 Provider 可配多个 key（逗号分隔），运行时组装为 KeyRotatingProvider。
# OPENAI_API_KEYS=sk-key1,sk-key2
# ANTHROPIC_API_KEYS=key1,key2

# ---------- 2 各条目默认模型 ----------
# 仅在该条目**未**出现在 ROUTING_POOLS（第 4 节）时生效；有池时模型由池的 tiers 决定。

# DEFAULT_MODEL=gpt-4o            # openai（Chat Completions）与 anthropic 条目的兜底模型
# DEEPSEEK_MODEL=deepseek-v4-pro
# KIMI_MODEL=kimi-k3
# GLM_MODEL=glm-5.3
# OPENAI_MODEL=gpt-5.6-terra      # gpt（Responses API）条目

# ---------- 3 本地 Ollama（OpenAI 兼容 /v1，显式 opt-in） ----------
# 启用后 ollama 条目构建为 OpenAIProvider（不校验 API Key，无需配 key），可经 /model 切换。
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b          # 启用时必填，缺失则启动即报错退出
# OLLAMA_API_KEY=                # 未填时用占位符 "ollama"
# 注意：本地窗口常远小于 MAX_CONTEXT_TOKENS 默认值（实际取 Modelfile 的 num_ctx），
#       须按实际值下调，否则压缩/窗口重置阈值永不触发、先撞 API 400。

# ---------- 4 智能路由（唯一入口：ROUTING_POOLS 声明式路由池） ----------
# 单个 JSON 对象，键 = provider 条目名（须已配好凭据；出现即启用该池），值 = 池规格：
#   {"tiers": {"<池内名>": "<模型名>", ...},   # 必填、有序；池内名即 /route 接受的名字
#    "roles": {"fast": "...", "mid": "...", "pro": "..."},   # 可选角色映射
#    "default": "<池内名>",                   # 可选，默认档（缺省 = fast 档）
#    "keywords": {"mid": "词1,词2", "pro": "词1,词2"},   # 可选，命中即路由到该档
#    "base_url": "https://...",               # 可选，覆盖该池的 base_url
#    "reasoning_continuity": false}           # 可选，覆盖该池的推理链续接
# 缺 roles 时按名字推断：池内名恰为 fast/mid/pro 者优先，否则首档 = fast、末档 = pro；
# 三档同义名的中档须显式写 roles。池声明了但无凭据 -> 告警并跳过该池。改档位只改这一行，无需改代码。
# ROUTING_POOLS={"glm":{"tiers":{"fast":"glm-5.3-flash","pro":"glm-5.3"},"keywords":{"pro":"分析,证明"}}}
# ROUTING_POOLS={"gpt":{"tiers":{"terra":"gpt-5.6-terra","luna":"gpt-5.6-luna","sol":"gpt-5.6-sol"},"roles":{"fast":"terra","mid":"luna","pro":"sol"},"default":"terra"}}

# 推理链续接（所有池的默认值；单池可用 "reasoning_continuity" 覆盖）：
# true = 上一轮走了 pro 且思考痕迹仍在历史中时，后续轮次继续走 pro；false（默认）= 只按当前请求判定。
# ROUTING_REASONING_CONTINUITY=false

# ---------- 5 Agent 运行参数 ----------

# MAX_ITERATIONS=50              # 单次 run 的主循环迭代上限
# GOAL_MAX_ITERATIONS=20         # /goal 声明式工作流每个步骤子代理的迭代预算（步骤可用 max_iterations 覆盖）
# SUBAGENT_MAX_DEPTH=3           # 子 Agent 委派嵌套深度上限（0=禁止委派；超限工具返回 status=error）
# SUBAGENT_MAX_ITERATIONS=20     # 嵌套子代理兜底迭代预算（角色未声明 max_iterations 时生效）
# GOAL_CHECKPOINT_MODE=prompt    # prompt=终端确认；auto=checkpoint 后自动继续
# GOAL_OPEN_QUESTION_MODE=block  # block=开放问题停 waiting_user；default=按推荐默认推进并记录假设
# GOAL_WORKFLOW_SKILL=he-goal    # /goal 工作流包 id（在 .heagent/skills/he-goal/SKILL.md 里声明 canonical_id）
# ANNOUNCE_PROGRESS=true         # ▶启动/✔完成 公告与状态行是否写 stderr；false=静音
# COMPRESSION_THRESHOLD=0.8      # 上下文压缩触发阈值（窗口占比）
# CONTEXT_STRATEGY=compressor    # compressor=原地摘要压缩；reset=窗口重置(清窗后 resume 续跑)
# WINDOW_RESET_THRESHOLD=0.6     # context_strategy=reset 时生效
# MAX_CONTEXT_TOKENS=512000      # 须 ≤ 所用模型的实际窗口，否则阈值永不触发、先撞 API 400
# MAX_OUTPUT_TOKENS=4096         # 单次输出 token 上限（不设则整行注释掉，留空会解析失败；本地思考模型建议设）
# SHELL_TIMEOUT=120              # shell 工具超时（秒）

# ---------- 6 Token 计量 ----------
# auto（默认）= 有 tiktoken 用真实 tokenizer，否则 CJK 感知启发式并按真实 usage 在线校准；
# estimate = 强制启发式；tiktoken = 强制真实（依赖缺失告警一次后回退）。
# TOKENIZER=auto

# ---------- 7 重试参数 ----------

# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=1.0
# RETRY_MAX_DELAY=30.0

# ---------- 8 技能 / 记忆 / 上下文 ----------

# SKILL_MATCH_THRESHOLD=0.3
# SKILL_MAX_AUTO_INVOKE=3
# SKILL_MAX_AUTO_INVOKE_TOKENS=8192  # 自动注入技能正文的总估算 token 预算；不设则整行注释掉（留空会解析失败）
# SKILL_MAX_MANUAL_LOAD_TOKENS=8192  # skill_load 的完整技能读取上限；超出时拒绝，不截断正文
# SKILL_CURATOR_STALE_DAYS=30        # 技能策展：多久未使用视为过期
# MEMORY_NUDGE_ENABLED=true          # 是否注入「记得保存记忆」提醒
# MEMORY_INJECT_MAX_BYTES=98304      # <memory> 注入字节预算（0=不限）；超预算按文件顺序保留前部条目并在块尾标注省略数
# MEMORY_ARCHIVE_TRIGGER_BYTES=49152 # MEMORY.md 的 fact 总字节超此值时，把中间老条目移入 archive/MEMORY-archive.md；0 = 禁用
# MEMORY_ARCHIVE_MIN_INTERVAL_SECONDS=86400  # 自动归档的节流间隔（秒）；0 = 不节流
# MEMORY_COMPACT_ENABLED=false     # MEMORY.md 语义压缩（fact_compact）写侧开关；无人监督删改持久记忆，默认关
# CONTEXT_FILES_ENABLED=true
# CONTEXT_FILES_MAX_BYTES=32768      # 上下文文件字节预算；超预算时近端（更靠近 cwd）优先，被丢弃者显式标注
# CONTEXT_FILES_USER_LEVEL=false     # 是否纳入用户级 ~/.heagent/AGENTS.md（全局文件，默认关闭）

# ---------- 9 事件传输与回放 ----------
# 落盘 .heagent/runs/<run_id>/rollout.jsonl（`heagent replay <file>` 可回放）；含工具原始输出。
# 单次模式加 --json 可把同一事件流写到 stdout（与 rollout 开关互不影响）。
# EVENTS_ROLLOUT_ENABLED=false

# ---------- 10 Cron 与 Dreaming ----------

# CRON_ENABLED=true
# CRON_TICK_SECONDS=60
# cron 结果推送（Epic 58，两个开关互相独立，默认都关）：
# CRON_PUSH_ENABLED=true 把 cron 每轮的最终答案投递到 `WS /api/notifications/ws`（缓冲 + seq 游标重放）；
# CRON_ECHO_TO_TERMINAL=true 在终端 stderr 回显一行 `[cron <job_id>] …`（不污染 --json 的 stdout）。
# 失败的一端同样会送达（status=failed + 异常首行）。goal 自动推进分支不发通知。
# CRON_PUSH_ENABLED=false
# CRON_ECHO_TO_TERMINAL=false

# Dreaming（离线记忆巩固，opt-in）：无人监督后台跑 + 联网 + 改持久记忆，非安全边界（须 OS 级沙箱兜底），默认关闭。
# 触发：cron 时刻命中，或距上次 run 结束已空闲 DREAM_IDLE_MINUTES。
# DREAM_ENABLED=false
# DREAM_CRON=0 3 * * *           # 5 字段 cron 表达式，构造期校验
# DREAM_IDLE_MINUTES=30          # 0 = 禁用 idle 触发
# DREAM_MAX_ITERATIONS=20        # dreamer 子代理独立预算（不复用 MAX_ITERATIONS）
# DREAM_SESSION_LOOKBACK=5       # 预加载近期 session 个数

# ---------- 11 状态清理 ----------
# 两项都在「全新 run 启动时」各清理一次；0 = 禁用清理。

# .heagent/ledger/ 幂等记录超过此天数即删除。
# LEDGER_RETENTION_DAYS=7

# .heagent/runs/ 的 run 快照（<run_id>.json + 配套 .lock + <run_id>/ 产物目录）超过此天数即删除；
# persist.py 刻意保留 .lock 文件，本项是 runs 侧唯一的回收时机。
# RUN_RETENTION_DAYS=7

# 过期清理的跨进程节流（秒）：距上次清理不足此间隔就跳过扫描（0 = 每次都扫）。
# PRUNE_MIN_INTERVAL_SECONDS=900

# 以下三项由 CLI/GUI 启动时的 housekeeping 回收；0 = 禁用该类清理。
# LOG_RETENTION_DAYS=14              # logs/ 日志文件（每次启动新建，含完整 prompt / 工具输出）
# SESSION_RETENTION_DAYS=30          # .heagent/sessions/ 会话文件
# EDIT_SNAPSHOT_RETENTION_DAYS=7     # .heagent/tmp/edit-snapshots/ 编辑快照（「误改后悔药」）

# ---------- 12 MCP 与工具黑名单 ----------

# MCP_ENABLED=true
# MCP_CONFIG_PATH=.mcp.json

# 工具名黑名单：命中即由 SafetyGuard 在执行前拦截，对所有工具生效（内置 / shell / MCP）。
# 值是 **JSON 数组**（不是逗号分隔），元素为正则片段、大小写不敏感；默认空 = 不拦。
# SAFETY_BLOCKED_TOOLS=["shell","delete_repository"]

# ---------- 13 沙箱（后端 / 权限档位 / 网络） ----------
# 后端：auto（默认）= 探测到 firejail 则用，否则 passthrough（零隔离）；firejail / winjob / docker 显式指定。
#       auto **不**自动选 winjob——Job 无文件系统隔离，需要时显式写。CLI --sandbox 可覆盖。
# SANDBOX_BACKEND=auto
# 注意：auto 只探 firejail，Windows 上落到 passthrough；容器档必须显式写 docker；
#       HeAgent 整进程已在容器内时 auto 同样只能 passthrough（隔离来自外层容器）。
# SANDBOX_FIREJAIL_PATH=firejail

# docker 沙箱（CONTAINER 档）：SANDBOX_BACKEND=docker 启用；镜像由 docker/sandbox/Dockerfile 构建。
# SANDBOX_DOCKER_IMAGE=heagent-sandbox:3.11
# 运行期 digest pin（可选）：非空时首 run 前 inspect 校验本地 tag 的 repo digest，不符显性拒绝（防 retag 静默换载荷）。
# SANDBOX_DOCKER_DIGEST=sha256:...

# 权限档位：read-only = 只放行只读工具，写操作与 shell 一律 BLOCKED（fail-closed）；
#           workspace-write = 默认：工作区围栏 + 凭证 deny + 审批管辖；
#           danger-full-access = 跳过围栏与凭证 deny 预检（显式危险模式，仅限受控环境）。
# 非法值回退 workspace-write 并告警。
# SANDBOX_MODE=workspace-write

# 网络开关：false（默认）= 禁止子进程出站（firejail --net=none / docker --network=none）；
# passthrough / winjob 无隔离能力，此时日志明确说明「隔离未生效」。宿主进程内的 web_fetch 不受此开关约束。
# SANDBOX_NETWORK=false

# 强制开关：true（默认）= 探测到**真实**沙箱后端时，自动把 shell 纳入沙箱工具集并授权当次 run 走沙箱路径；
# passthrough 时不改变任何行为——不给「已在沙箱里跑」的假象。
# SANDBOX_ENFORCE=true

# 会话目录：true = 每个 run 建 <workspace>/.heagent/sandboxes/<run_id>/ 作为沙箱工作目录；
# SESSION_KEEP=true 时 run 结束保留。可被 CLI/GUI 开关双向覆盖：
#   --sandbox-session-workspace / --no-sandbox-session-workspace、--sandbox-session-keep / --no-sandbox-session-keep
# SANDBOX_SESSION_WORKSPACE=false
# SANDBOX_SESSION_KEEP=false

# 崩溃 run 留下的孤儿会话目录由 CLI/GUI 启动时按本保留期回收（0 = 禁用）；正在写的 run 不会被删。
# SANDBOX_DIR_RETENTION_DAYS=7

# env 豁免：逗号分隔变量名（如 GITHUB_TOKEN），命中的变量不参与子进程 env 敏感剥离。
# SANDBOX_ENV_ALLOWLIST=

# profile → firejail 参数映射（JSON）：高级隔离参数（--seccomp / --caps.drop 等）经此声明，默认关闭。
# 示例：SANDBOX_PROFILES={"default": ["--seccomp", "--caps.drop=all"]}；均为启发式层，**非真正安全边界**。
# SANDBOX_PROFILES=

# 工具 → profile 名映射（JSON，per-tool 粒度）。
# 示例：SANDBOX_TOOL_PROFILES={"shell": "strict", "mcp_github__run": "network-off"}；空 = 全部落 "default"。
# SANDBOX_TOOL_PROFILES=

# 资源限额（0=关闭）：沙箱内 shell 子进程的内存上限（MB）、CPU 时间上限（秒）、进程数上限；
# 触发即终止子进程、非零退出码经正常结果回传。firejail 映射 --rlimit-*；winjob 映射 Job 限额。
# ⚠ NPROC 两后端语义不对称：firejail 按 Linux 真实 UID 计数（会波及同用户其他进程），winjob 才是 job 作用域，故默认关。
# SANDBOX_MEMORY_LIMIT_MB=0
# SANDBOX_CPU_SECONDS=0
# SANDBOX_NPROC_LIMIT=0

# ---------- 14 审批 / Plan Mode ----------
# 逗号分隔的需要交互审批的工具名（如 "shell,file_write"）。空 = 无审批工具。
# 交互模式在这些工具执行前询问 [y/N]；单次模式非 tty 时保持 auto-deny。
# APPROVAL_TOOLS=

# true = 只读规划模式：仅允许 readOnlyHint 工具，禁用 shell / 写文件等写操作。CLI --plan 可覆盖。
# PLAN_MODE=false

# ---------- 15 用户事件钩子 ----------
# true = 加载 workspace 下 .heagent/hooks.json（PreToolUse 可阻断 / PostToolUse / SessionStart / SessionEnd）。
# 默认 false：hooks 以当前用户权限执行任意命令（非安全边界），不可信仓库可投放 hooks.json 自动执行——须显式开启。
# hook 子进程仅继承白名单环境变量（不含 API key）。
# HOOKS_ENABLED=false

# ---------- 16 成本估算 ----------
# 模型价格表 JSON：{"<model>": {"input": <$/M tok>, "output": <$/M tok>}}。空 = 不显示成本。
# 例：{"deepseek-v4-pro": {"input": 0.27, "output": 1.1}}
# MODEL_PRICING=

# ---------- 17 日志 ----------
# LOG_DIR 相对当前工作目录；每次启动在下面新建 heagent-<时间戳>.log。
# LOG_LEVEL 控制 stderr 控制台级别；LOG_FILE_LEVEL 控制文件日志级别，不设时回退到 LOG_LEVEL。

# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_FILE_LEVEL=

# ---------- 18 HTTP 网页入口（实验性） ----------
# `heagent http-server` 提供本机网页入口（内置聊天页 + /api/* 同源 JSON 接口）；gui / init / replay 不附带启动。
# 定位：实验性、**无认证、无 TLS**，默认只绑 localhost；回环不是认证边界，收到的请求即不可信输入，对外须 OS 级沙箱兜底。
# 页面不加载第三方脚本，统一带 CSP / nosniff / 禁 framing；提示词与 Agent 输出按纯文本渲染（不渲染不可信 HTML）。
# 依赖为可选 extra：pip install "heagent[http]"
# 装配开关：HTTP_ENABLED=False 关 HTTP listener（WS_ENABLED=False 关 WS；两者都 false = 零监听，交互模式仍可用）；
# CLI 另有单次覆盖：--no-http / --no-ws 及 --host / --port 等同名参数（只作用于本次实例，不写回设置单例）。
# 非法值（端口范围、计数为 0、非正超时、空 host）在加载时显式校验失败，不静默放宽。

# HTTP_ENABLED=True                 # False = 不装配 HTTP listener（仅 WS 或全关）
# HTTP_HOST=127.0.0.1               # 绑定地址（非回环值启动时打明确告警）
# HTTP_PORT=8766                    # 网页入口端口
# HTTP_PORT_AUTO_FIND_ATTEMPTS=10   # 端口被占时自动顺延次数（默认 10 = 开）；只对未显式传 --port 的路径生效，显式端口冲突即报错
# HTTP_MAX_CONNECTIONS=16           # 客户端连接上限（超限直接拒绝；内部另预留 1 条给就绪探测）
# HTTP_MAX_SUBSCRIBERS=16           # 每 run 的 SSE 订阅者上限；超限回 429 rate_limited
# HTTP_MAX_INFLIGHT_RUNS=1          # 每项目在途网页 Agent 运行上限（满即 409 run_conflict）
# HTTP_MAX_TOTAL_INFLIGHT=0         # 服务级在途运行总额（跨项目共享）；0 = 不限，保持按项目语义
# HTTP_MAX_REQUEST_BYTES=394240     # 单个 JSON 请求体字节上限（默认装得下最大 prompt，勿调小）
# HTTP_EVENT_BUFFER_SIZE=512        # 每 run 的 SSE 事件环形缓冲条数（越窗重连收 resync_required）
# HTTP_RUN_HISTORY_SIZE=64          # 已终结 run 记录保留条数（淘汰后按 id 订阅收 unknown_run）
# HTTP_REQUEST_TIMEOUT=0            # 单次运行**总时长**上限（秒）；0 = 不限——「跑得久」不等于「卡死」，长任务别用墙钟杀
# HTTP_IDLE_TIMEOUT=300             # 单次运行**静默**上限（秒）：无新事件且无在途工具才算卡死；0 = 关闭静默判定
# HTTP_TOOL_INFLIGHT_TIMEOUT=3600   # 单个**在途工具**最长在途时间（秒）；刻意与静默阈值分开以免误杀正常长调用；0 = 不限
# HTTP_SHUTDOWN_TIMEOUT=5           # 关闭排空（停接收 → 终结在途 run → 关订阅 → 关 listener）的等待上限（秒）

# ---- WS 入口（与 HTTP 完全分离的独立 server，所有 WS 能力的唯一宿主）----
# 默认 127.0.0.1:9901。端点：提交 /api/runs/ws、订阅 /api/runs/{run_id}/ws、CLI 旁路 /api/cli/ws。
# 回环绑定 = 本地模式（无认证无 TLS，Origin 校验只是入口层 defense-in-depth）；
# 非回环 = **对外模式**（Bearer token 强制、缺 token 拒绝启动 fail-closed、Origin 不适用）。
# 端口自动查找复用 HTTP_PORT_AUTO_FIND_ATTEMPTS，两条 listener 独立顺延。
# WS_ENABLED=True                   # False = 不装配 WS listener（仅 HTTP 或全关）
# WS_HOST=127.0.0.1                 # 非回环 = 对外模式：须先在 ~/.heagent/setting.md 配 `WS_AUTH_TOKEN: <token>`，否则拒绝启动
# WS_PORT=9901                      # WS 入口端口
# WS_MAX_CONNECTIONS=16             # 每 run 订阅额度 + CLI 旁路连接总额；超额回 rate_limited 错误帧
# WS_SHUTDOWN_TIMEOUT=5             # WS server 关闭排空的等待上限（秒）
# WS_TLS_CERT_FILE=                 # listener TLS：PEM 证书/私钥路径，**成对**配齐即 wss，只配一半拒绝启动；
# WS_TLS_KEY_FILE=                  # 主 listener 与对外 listener 共用（对外侧可用 WS_EXTERNAL_TLS_* 成对覆盖）；不配 = 明文（对外侧另打告警）

# ---- WS 第二个 listener（本机免 token + 对外带 token 同时服务）----
# 主 listener（WS_HOST/WS_PORT）语义不变；下面这条是**额外**的对外 listener，默认不启用。
# WS_EXTERNAL_HOST=                 # 非空即启用；**必须非回环**（回环值或主 listener 已非回环时都拒绝启动）
# WS_EXTERNAL_PORT=9002             # 对外 listener 端口（0.0.0.0:9901 与 127.0.0.1:9901 在 Windows 上会冲突）
# WS_EXTERNAL_TLS_CERT_FILE=        # 对外 listener 的 TLS：cert+key **成对**给才生效；
# WS_EXTERNAL_TLS_KEY_FILE=         # 两个都不给 ⇒ 整对继承上面的 WS_TLS_*（便于「本地明文 + 对外 wss」）
# WS_EXTERNAL_READONLY=false        # 只读旁观：true 时对外 listener **不注册**提交端点、cancel 回 invalid_request——给看不给下命令
# 对外端点集 = {/api/runs/ws, /api/runs/{run_id}/ws}；**CLI 旁路 /api/cli/ws 只挂本地 listener**（终端事件可能含文件内容）。
# 对外模式的 token **不在本文件**——项目 .env 写 WS_AUTH_TOKEN **不生效**（启动时告警）；
# 凭证只认用户级 `~/.heagent/setting.md` 的 `WS_AUTH_TOKEN`，以免仓库作者预置一个已知 token。
# WS_CLI_BYPASS_ENABLED=false       # CLI 旁路订阅（默认关）：把**终端里那一轮** run 的事件实时推给外部客户端；
#                                   # 只读、无认证、不占运行名额、不写会话历史；开了等于本机进程可见终端 agent 的工具输出
# HTTP_CONSOLE_WRITE_ENABLED=false  # 网页控制台的配置写入通道（**默认关**）：开启 = 任何能连上该端口的人都能改项目 .env（启动时高亮告警）；
#                                   # 只写项目 .env、只认白名单、写前备份写后回读，但仍非安全边界，须 OS 级沙箱兜底
# HTTP_CONSOLE_PROJECTS_FILE=       # 项目注册表落点覆盖（缺省 <服务启动工作区>/.heagent/console/projects.json；
#                                   # 需机器级共享时显式指向 ~/.heagent/projects.json）
