# HeAgent 配置示例
#
# 复制为 .env 后填写真实值：
#   cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# 读取优先级：系统环境变量 > .env > 默认值
# 字段与 src/heagent/config.py 中的 Settings 对应

# ---------- Provider 凭据 ----------
# 至少配置一个。CLI 默认按 DeepSeek -> OpenAI -> Anthropic 的顺序组装 Provider。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenAI Responses API（wire_api="responses" 的中转站，如 komapi.top 的 GPT-5.x）。
# 区别于上方 OPENAI_API_KEY（Chat Completions API）；本项走 /v1/responses，/model gpt 切换。
# OPENAI_RESPONSES_API_KEY=
# OPENAI_RESPONSES_BASE_URL=https://www.komapi.top/v1
# gpt 条目的默认模型（Responses API）；声明了 gpt 池则改由池的 tiers 决定。
# OPENAI_MODEL=gpt-5.6-terra
# 注：openai（Chat Completions）条目与 anthropic 条目的兜底模型用 DEFAULT_MODEL。

# ---------- 本地 Ollama（OpenAI 兼容 /v1，显式 opt-in） ----------
# 启用后 CLI 把 ollama 条目构建为 OpenAIProvider（Ollama 不校验 API Key，无需配 key），
# 与云端 provider 并列入池，可经 /model 切换、--model 覆盖模型名。
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b
# 查看本机模型名与窗口：curl http://127.0.0.1:11434/api/tags
# 注意：本地窗口常远小于 MAX_CONTEXT_TOKENS 默认 512000（Ollama 实际取 Modelfile 的 num_ctx），
#       须按实际值下调，否则压缩/窗口重置阈值永不触发、先撞 API 400。

# ---------- 多 key 池 ----------
# 同一 Provider 可配置多个 key，运行时会去重并组装为 KeyRotatingProvider。

# OPENAI_API_KEYS=sk-key1,sk-key2
# ANTHROPIC_API_KEYS=key1,key2

# ---------- Anthropic 提示缓存 ----------
# 对不支持 cache_control 的代理请显式关闭。

ANTHROPIC_PROMPT_CACHING=true

# ---------- 模型与 Agent 运行参数 ----------

# DEFAULT_MODEL=gpt-4o
# MAX_ITERATIONS=50
# GOAL_CHECKPOINT_MODE=prompt  # prompt=终端确认；auto=checkpoint 后自动继续
# GOAL_OPEN_QUESTION_MODE=block  # block=开放问题停 waiting_user；default=按推荐默认推进并记录假设
# ANNOUNCE_PROGRESS=true  # ▶启动/✔完成 公告与状态行是否写 stderr；false=静音（公告会挤进交互输入行时用）
# SUBAGENT_MAX_DEPTH=3  # 子 Agent 委派嵌套深度上限（0=禁止委派；超限工具返回 status=error）
# SUBAGENT_MAX_ITERATIONS=20  # 嵌套子代理兜底迭代预算（角色未声明 max_iterations 时生效；task_delegate/task_parallel）
# COMPRESSION_THRESHOLD=0.8
# CONTEXT_STRATEGY=compressor   # compressor=原地摘要压缩；reset=窗口重置(清窗后 resume 续跑)
# WINDOW_RESET_THRESHOLD=0.6    # context_strategy=reset 时生效
# MAX_CONTEXT_TOKENS=512000
# MAX_OUTPUT_TOKENS=4096   # 可选：单次输出 token 上限（None=不设；本地思考模型建议设，防无限生成）
# SHELL_TIMEOUT=120

# ---------- 重试参数 ----------

# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=1.0
# RETRY_MAX_DELAY=30.0

# ---------- 技能 / 记忆 / 上下文 ----------

# SKILL_MATCH_THRESHOLD=0.3
# SKILL_MAX_AUTO_INVOKE=3
# SKILL_MAX_AUTO_INVOKE_TOKENS=8192  # 可选；空值表示不设自动注入 token 上限
# SKILL_MAX_MANUAL_LOAD_TOKENS=8192  # skill_load 的完整技能读取上限；超出时拒绝，不截断正文
# CONTEXT_FILES_ENABLED=true
# MEMORY_NUDGE_ENABLED=true
# SKILL_CURATOR_STALE_DAYS=30

# ---------- Cron ----------

# CRON_ENABLED=true
# CRON_TICK_SECONDS=60

# ---------- Ledger 自动清理 ----------
# .heagent/ledger/ 幂等记录超过此天数在 run 启动时自动删除；0=禁用清理（默认 7）。

# LEDGER_RETENTION_DAYS=7

# ---------- MCP ----------

# MCP_ENABLED=true
# MCP_CONFIG_PATH=.mcp.json
# ---------- 智能路由（唯一入口：ROUTING_POOLS 声明式路由池） ----------
# 单个 JSON 对象，键 = provider 条目名（deepseek / kimi / glm / ollama / openai / gpt /
# anthropic；该条目须已配好凭据；**条目一旦出现在这里即为启用该池**），值 = 池规格：
#   {"tiers": {"<池内名>": "<模型名>", ...},   # 必填、有序；池内名即 /route 接受的名字
#    "roles": {"fast": "<池内名>", "mid": "<池内名>", "pro": "<池内名>"},   # 可选角色映射
#    "default": "<池内名>",                   # 可选，默认档（缺省 = fast 档）
#    "keywords": {"mid": "词1,词2", "pro": "词1,词2"},   # 可选，命中即路由到该档
#    "base_url": "https://...",               # 可选，覆盖该池的 base_url
#    "reasoning_continuity": false}           # 可选，覆盖该池的推理链续接
# 缺 roles 时按名字推断：池内名恰为 fast/mid/pro 者优先，否则首档 = fast、末档 = pro；
# 三档同义名（如 terra/luna/sol）中间档须显式写 roles。
# 调整档位模型 / 新增档位 / 改角色与关键词只改这一行，**无需改代码**。
# 例：
# ROUTING_POOLS={"glm":{"tiers":{"fast":"glm-5.3-flash","pro":"glm-5.3"},"keywords":{"pro":"分析,证明"}}}
# ROUTING_POOLS={"gpt":{"tiers":{"terra":"gpt-5.6-terra","luna":"gpt-5.6-luna","sol":"gpt-5.6-sol"},"roles":{"fast":"terra","mid":"luna","pro":"sol"},"default":"terra"}}
# ROUTING_POOLS={"deepseek":{"tiers":{"fast":"deepseek-flash","pro":"deepseek-v4-pro"}}}

# 推理链续接（判据 1，**所有池的默认值**；单池可在上面用 "reasoning_continuity" 覆盖）：
# true 时「上一轮走了 pro 且思考痕迹仍在历史中」会让后续轮次即使没命中关键词也继续走 pro；
# 默认 false = 尽量用 fast（只按当前请求判定，历史命中不锁定）。
# ROUTING_REASONING_CONTINUITY=false
# 注：旧版按 provider 的开关（ROUTING_ENABLED / ROUTING_FAST_MODEL / ROUTING_PRO_MODEL /
#     ROUTING_REASONING_KEYWORDS / GPT_ROUTING_*）已移除，请在 ROUTING_POOLS 里声明对应池。

# ---------- 用户事件钩子（Epic 32） ----------
# true = 加载 workspace 下 .heagent/hooks.json（PreToolUse 可阻断 / PostToolUse /
#        SessionStart / SessionEnd 执行用户配置的本地命令）。
# 默认 false：hooks 以当前用户权限执行任意命令（非安全边界），不可信仓库可投放
# hooks.json 自动执行——须显式开启。hook 子进程仅继承白名单环境变量（不含 API key）。

# HOOKS_ENABLED=false

# ---------- 沙箱（P0-2：后端 / 权限档位 / 网络） ----------
# 后端：auto（默认）= 探测 firejail，可用则用（Linux/macOS），否则 passthrough；
#       passthrough = 零隔离；firejail = FirejailBackend；winjob = Windows Job Objects。
#       auto **不**自动选 winjob——Job 无文件系统隔离，自动启用会改掉所有 shell 命令的
#       进程语义而隔离收益有限；需要时显式写 winjob。CLI --sandbox 可覆盖。
# SANDBOX_BACKEND=auto
# SANDBOX_FIREJAIL_PATH=firejail

# 权限档位：
#   read-only          = 只放行只读工具（file_read / git_* / web_fetch 等）；写操作与 shell
#                        一律 BLOCKED，未知工具同样拒绝（fail-closed）；
#   workspace-write    = 默认：写操作受工作区围栏 + 凭证 deny + 审批管辖；
#   danger-full-access = 跳过围栏与凭证 deny 预检（显式危险模式，仅限受控环境）。
# 非法值回退 workspace-write 并告警（不阻断启动）。
# SANDBOX_MODE=workspace-write

# 网络开关：false（默认）= 禁止子进程出站。**仅 firejail 能强制**（映射为 --net=none）；
# passthrough / winjob 无网络隔离能力，此时日志会明确说明「隔离未生效」而非假装生效。
# 注：宿主进程内的 web_fetch 不受此开关约束。
# SANDBOX_NETWORK=false

# 强制开关：true（默认）= 探测到**真实**沙箱后端时，自动把 shell 纳入沙箱工具集并授权当次
# run 走沙箱路径。无真实后端（passthrough）时不改变任何行为——不给「已在沙箱里跑」的假象。
# SANDBOX_ENFORCE=true

# 会话目录：true = 每个 run 建 <workspace>/.heagent/sandboxes/<run_id>/ 作为沙箱工作目录
# （firejail 作 --private 根 / winjob 作子进程 cwd）；SESSION_KEEP=true 时 run 结束保留。
# SANDBOX_SESSION_WORKSPACE=false
# SANDBOX_SESSION_KEEP=false

# env 豁免：逗号分隔变量名（如 GITHUB_TOKEN），命中的变量不参与子进程 env 敏感剥离。
# SANDBOX_ENV_ALLOWLIST=

# ---------- 审批（Epic 29） ----------
# 逗号分隔的需要交互审批的工具名（如 "shell,file_write"）。空 = 无审批工具。
# 交互模式会在这些工具执行前询问 [y/N]；单次模式非 tty 时保持 auto-deny。

# APPROVAL_TOOLS=

# ---------- Plan Mode（Epic 33） ----------
# true = 只读规划模式：仅允许 readOnlyHint 工具，禁用 shell / 写文件等写操作。
# CLI --plan flag 可覆盖。

# PLAN_MODE=false

# ---------- 成本估算（Epic 34） ----------
# 模型价格表 JSON：{"<model>": {"input": <$/M tok>, "output": <$/M tok>}}。空 = 不显示成本。
# 例：{"deepseek-v4-pro": {"input": 0.27, "output": 1.1}}

# MODEL_PRICING=
